# OpenAI settings — copy to .env and fill in your key
OPENAI_API_KEY=sk-your-key-here
# Optional: point at a compatible API (e.g. OpenRouter, Ollama, LM Studio)
#OPENAI_BASE_URL=https://api.openai.com/v1
# Model used for chat (default: gpt-4o-mini)
#OPENAI_MODEL=gpt-4o-mini

# SearXNG metasearch endpoint used by the `search` MCP server.
# The default http://searxng:8080 works inside docker compose; on the host use
# http://localhost:8080 instead.
#SEARXNG_URL=http://searxng:8080
